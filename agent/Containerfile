# The Objective-Superintelligence agent image: a musl binary on Alpine.
#
# The container proxy is NOT in this image. The host injects it at
# runtime.
#
# Build from THIS directory. The crate takes the Diverge SDK by git at
# a pinned commit, so the build needs the network and nothing beside
# this directory:
#
#     podman build -f Containerfile .
#
# Digests as the Diverge example images pin them; bump deliberately.

# rust:1.98.0-alpine3.24: the musl toolchain is the image's default
# target, so what it builds runs on the Alpine below.
FROM docker.io/library/rust:1.98.0-alpine3.24@sha256:a10e64dd139b7387337c7fbe8aca31b959b57b2fd4c8ae20a02cf1d6ea424dce AS build

# `ring` (the crypto under the SDK's HTTP client) compiles C;
# build-base is the whole musl C toolchain. git: the SDK is fetched
# from its repository.
RUN apk add --no-cache build-base git

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY src src
# The tool image this agent declares, compiled into the binary.
COPY tool-image.json tool-image.json

# --locked: the versions the lockfile beside the crate resolved.
RUN cargo build --release --locked

# alpine:latest, by digest.
FROM docker.io/library/alpine@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

COPY --from=build /build/target/release/agent /usr/local/bin/agent

# The image's arguments schema and its description, read by the proxy.
COPY DIVERGE.md /DIVERGE.md

# The program's own server, on the loopback: 8080, or whatever `PORT`
# names. Nothing is exposed: the proxy the host injects is the only
# thing that dials it, and it is beside it.

ENTRYPOINT ["/usr/local/bin/agent"]
